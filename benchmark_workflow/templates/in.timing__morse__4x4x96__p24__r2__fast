clear
units lj
dimension 3
boundary p p p
atom_style atomic
processors 1 1 24
read_data baseline/assets/prepare__morse__4x4x96.data
mass 1 1
mass 2 1
pair_style morse 2.4
pair_coeff 1 1 1.00 2.0 1.00 2.4
pair_coeff 1 2 1.10 2.0 0.98 2.4
pair_coeff 2 2 0.85 2.0 0.95 2.4
neighbor 0.3 bin
neigh_modify delay 0 every 1 check yes
timestep 0.0
fix integrate all nve
variable ncycle equal 6144
variable seed equal 24682357
variable tmc equal 1
compute ctype all count/type atom
fix mc all fast/swap 1 ${ncycle} ${tmc} ${seed} types 2 1 2 mu 0 0.2
variable epa equal pe/atoms
thermo_style custom step atoms pe v_epa c_ctype[1] c_ctype[2] f_mc[1] f_mc[2] temp press vol
thermo_modify norm no format float %.17g
thermo 1
run 1
print "REVISION_PRODUCTION_BEGIN"
thermo 2
run 2
print "REVISION_PRODUCTION_END"
