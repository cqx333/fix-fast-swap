clear
units lj
dimension 3
boundary p p p
atom_style atomic
processors 1 1 1
read_data results/raw/prepare__lj_cut__8x8x8.data
mass 1 1
mass 2 1
pair_style lj/cut 2.4
pair_coeff 1 1 1.00 1.00 2.4
pair_coeff 1 2 1.10 0.98 2.4
pair_coeff 2 2 0.85 0.95 2.4
neighbor 0.3 bin
neigh_modify delay 0 every 1 check yes
timestep 0.0
fix integrate all nve
variable ncycle equal 2048
variable seed equal 24683357
variable tmc equal 1
compute ctype all count/type atom
fix mc all atom/swap 1 ${ncycle} ${seed} ${tmc} ke no semi-grand yes types 1 2 mu 0 0.2
variable epa equal pe/atoms
thermo_style custom step atoms pe v_epa c_ctype[1] c_ctype[2] f_mc[1] f_mc[2] temp press vol
thermo_modify norm no format float %.17g
thermo 1
run 1
print "REVISION_PRODUCTION_BEGIN"
thermo 3
run 3
print "REVISION_PRODUCTION_END"
