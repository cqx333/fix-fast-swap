clear
units lj
dimension 3
boundary p p p
atom_style atomic
processors 1 1 1
comm_style brick
newton on
lattice fcc 0.8442 origin 0.25 0.25 0.25
region box block 0 10 0 15 0 20 units lattice
create_box 2 box
create_atoms 1 box
region upper block INF INF INF INF 10 20 units lattice
set region upper type 2
mass 1 1.0
mass 2 1.0
pair_style lj/cut 2.4
pair_coeff 1 1 1.00 1.00 2.4
pair_coeff 1 2 1.10 0.98 2.4
pair_coeff 2 2 0.85 0.95 2.4
pair_modify shift no tail no
neighbor 0.3 bin
neigh_modify delay 0 every 1 check yes
timestep 0.0
fix integrate all nve
variable ncycle equal 12000
variable seed equal 24681357
variable tmc equal 1.0
compute ctype all count/type atom
fix mc all fast/swap 1 ${ncycle} ${tmc} ${seed} types 2 1 2 mu 0 0.2
variable epa equal pe/atoms
thermo_style custom step atoms pe v_epa c_ctype[1] c_ctype[2] f_mc[1] f_mc[2] temp press vol
thermo_modify norm no format float %.17g
thermo 1
print "REVISION_PRODUCTION_BEGIN"
run 160
print "REVISION_PRODUCTION_END"
write_dump all custom results/raw/prepare3d__lj_cut__10x15x20.final.dump id type x y z modify sort id format float %.17g
write_data results/raw/prepare3d__lj_cut__10x15x20.data nocoeff
