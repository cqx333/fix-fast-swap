# Single-rank fixed-position demonstration, N=864; run with mpirun -np 1.
units lj
atom_style atomic
boundary p p p
lattice fcc 0.8442
region box block 0 6 0 6 0 6 units lattice
create_box 2 box
create_atoms 1 box
mass * 1.0
set type 1 type/fraction 2 0.5 314159
pair_style lj/cut 2.4
pair_coeff 1 1 1.00 1.00 2.4
pair_coeff 1 2 1.10 0.98 2.4
pair_coeff 2 2 0.85 0.95 2.4
neighbor 0.3 bin
neigh_modify every 1 delay 0 check yes
fix integrate all nve
timestep 0.0
fix mc all atom/swap 1 864 24681357 1.0 types 1 2 semi-grand yes mu 0.0 0.2
thermo 1
thermo_style custom step atoms pe f_mc[1] f_mc[2]
thermo_modify norm no
run 10
