clear
units lj
dimension 3
boundary p p p
atom_style charge

variable ncycle equal 500
variable nsweeps equal 3
variable seed equal 24681357
variable tmc equal 1.0

lattice fcc 0.8442
region box block 0 5 0 5 0 5 units lattice
create_box 2 box
create_atoms 1 box
region upper block INF INF INF INF 2.5 5 units lattice
set region upper type 2
mass 1 1
mass 2 1
set type 1 charge 0.3
set type 2 charge -0.3

pair_style buck/coul/cut 2.4
pair_coeff 1 1 1.00 1.00 0.10 2.4
pair_coeff 1 2 1.10 1.00 0.10 2.4
pair_coeff 2 2 0.85 1.00 0.10 2.4

neighbor 0.3 bin
neigh_modify delay 0 every 1 check yes
timestep 0.0
fix int all nve

compute ctype all count/type atom
fix mc all fast/swap 1 ${ncycle} ${tmc} ${seed} types 2 1 2 mu 0 0.2
thermo 1
thermo_modify format float %.17g
thermo_style custom step pe c_ctype[1] c_ctype[2] f_mc[1] f_mc[2]
run ${nsweeps}

write_data results/boundary__charge_mismatch__fast.data nocoeff
