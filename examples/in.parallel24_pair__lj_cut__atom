clear
units lj
dimension 3
boundary p p p
atom_style atomic
processors 1 1 24

variable ncycle equal 6144
variable nsweeps equal 6
variable seed equal 24681357
variable tmc equal 1.0

lattice fcc 0.8442
region box block 0 4 0 4 0 96 units lattice
create_box 2 box
create_atoms 1 box
region upper block INF INF INF INF 48 96 units lattice
set region upper type 2
mass 1 1
mass 2 1

pair_style lj/cut 2.4
pair_coeff 1 1 1.00 1.00 2.4
pair_coeff 1 2 1.10 0.98 2.4
pair_coeff 2 2 0.85 0.95 2.4

neighbor 0.3 bin
neigh_modify delay 0 every 1 check yes
timestep 0.0
fix int all nve

compute ctype all count/type atom
fix mc all atom/swap 1 ${ncycle} ${seed} ${tmc} ke no semi-grand yes types 1 2 mu 0 0.2
thermo 50
thermo_modify format float %.17g
thermo_style custom step pe c_ctype[1] c_ctype[2] f_mc[1] f_mc[2]
run ${nsweeps}

write_data results/parallel24_pair__lj_cut__atom.data nocoeff
